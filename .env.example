# ============================================================
# tradutor-artigos — configuração
# Copie para .env e ajuste. NÃO comite o .env (contém API key).
# ============================================================

# Backend padrão quando --backend não é passado: local | gemini
BACKEND=local

# Diretório de saída padrão
OUTPUT_DIR=./output

# ---------- Backend LOCAL (LM Studio / OpenAI-compatible) ----------
# LM Studio na própria máquina:
LOCAL_BASE_URL=http://localhost:1234/v1
# LM Studio rodando no MacBook, acessado do desktop via Tailscale:
# LOCAL_BASE_URL=http://macbook-m5.tailnet-xxxx.ts.net:1234/v1

# Nome do modelo carregado no LM Studio (aba Developer > Server mostra o id exato)
LOCAL_MODEL=qwen3-14b

# LM Studio não valida a key, mas o campo é obrigatório
LOCAL_API_KEY=lm-studio

# Paralelismo local: 4 é seguro; suba se o servidor aguentar
LOCAL_QPS=4
LOCAL_WORKERS=4

# Seletor de modelo/placas no site (opcional — só faz sentido no desktop).
# JSON com os modelos ofertados: "id" é o model key do LM Studio, "gpus" são as
# combinações permitidas (índices na ordem do nvidia-smi; a primeira é o default),
# "context" limita o contexto no load (controla o quanto de VRAM o KV cache come).
# O servidor descarrega/carrega o modelo no LM Studio a cada troca, com split por
# prioridade na primeira placa da combinação. Sem esta variável não há seletor e
# vale o LOCAL_MODEL acima (caso do mac).
#MODEL_OPTIONS=[{"id":"qwen/qwen3-8b","label":"Qwen3 8B","context":8192,"gpus":[[0],[1],[0,1]]},{"id":"qwen/qwen3-14b","label":"Qwen3 14B","context":8192,"gpus":[[0],[0,1]]},{"id":"qwen/qwen3-32b","label":"Qwen3 32B","context":8192,"gpus":[[0,1]]}]

# ---------- Frontend web (server.py) ----------
# Identidade desta máquina no seletor do site. Rodando via Docker isso vem do
# compose (NODE_ID=desktop / NODE_ID=mac), que tem precedência sobre o .env;
# rodando direto e sem definir, vira "local" e o site fica em máquina única.
#NODE_ID=desktop
#NODE_LABEL=Desktop RTX 3050

# Porta do servidor web; no Docker o compose mapeia 8010:8010
FRONTEND_PORT=8010
# Bind do servidor: 127.0.0.1 rodando direto (dev); no Docker a imagem
# já define 0.0.0.0 (necessário p/ receber o proxy da VPS via Tailscale)
#FRONTEND_HOST=127.0.0.1

# Obs: rodando via docker compose, o LOCAL_BASE_URL acima é ignorado —
# o compose injeta http://host.docker.internal:1234/v1 (LM Studio no Windows).

# ---------- Cloudflare R2 ----------
# Painel Cloudflare > R2 > Manage R2 API Tokens (token com Object Read & Write
# no bucket). Preenchido, habilita mandar arquivo para o acervo — o que NÃO
# acontece sozinho: só pelo botão "enviar para o acervo" ou pelo `r2 push`.
# Vazio, tudo funciona igual, mas sem acervo (os arquivos ficam só na máquina).
#
# É também o que sustenta o acervo do site: o hub na VPS lê o mesmo bucket e
# serve os downloads com os PCs desligados. Use as MESMAS credenciais nas duas
# máquinas (as chaves são jobs/<id>/…, não colidem). No hub, um token só de
# leitura basta — ver deploy/hub/docker-compose.yml.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=traduzia

# ---------- Backend GEMINI ----------
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free tier tem rate limit — QPS=1 evita erros 429.
# Se assinar o tier pago, pode subir para 4-8.
GEMINI_QPS=1
